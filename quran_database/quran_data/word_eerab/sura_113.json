                "aya_number": 1,
                "word_number": 3,
                "word": "بِرَبِّ",
                "content": "(الْبَاءُ) حَرْفُ جَرٍّ مَبْنِيٌّ عَلَى الْكَسْرِ، وَ﴿رَبِّ﴾ اسْمٌ مَجْرُورٌ وَعَلَامَةُ جَرِّهِ الْكَسْرَةُ الظَّاهِرَةُ وَهُوَ مُضَافٌ."
            },
            {
                "sura_number": 113,
                "sura_name": "الفلق",
                "aya_number": 1,
                "word_number": 4,
                "word": "الْفَلَقِ",
                "content": "مُضَافٌ إِلَيْهِ مَجْرُورٌ وَعَلَامَةُ جَرِّهِ الْكَسْرَةُ الظَّاهِرَةُ."
            }
        ]
