                "word": "قُلْ",
                "content": "فِعْلُ أَمْرٍ مَبْنِيٌّ عَلَى السُّكُونِ، وَالْفَاعِلُ ضَمِيرٌ مُسْتَتِرٌ تَقْدِيرُهُ (أَنْتَ)."
            },
            {
                "sura_number": 113,
                "sura_name": "الفلق",
                "aya_number": 1,
                "word_number": 2,
                "word": "أَعُوذُ",
                "content": "فِعْلٌ مُضَارِعٌ مَرْفُوعٌ وَعَلَامَةُ رَفْعِهِ الضَّمَّةُ الظَّاهِرَةُ، وَالْفَاعِلُ ضَمِيرٌ مُسْتَتِرٌ تَقْدِيرُهُ (أَنَا)."
            },
            {
                "sura_number": 113,
