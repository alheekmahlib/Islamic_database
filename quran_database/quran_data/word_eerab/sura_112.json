                "aya_number": 1,
                "word_number": 1,
                "word": "قُلْ",
                "content": "فِعْلُ أَمْرٍ مَبْنِيٌّ عَلَى السُّكُونِ، وَالْفَاعِلُ ضَمِيرٌ مُسْتَتِرٌ تَقْدِيرُهُ (أَنْتَ)."
            },
            {
                "sura_number": 112,
                "sura_name": "الإخلاص",
                "aya_number": 1,
                "word_number": 2,
                "word": "هُوَ",
                "content": "ضَمِيرٌ مُنْفَصِلٌ مَبْنِيٌّ عَلَى الْفَتْحِ فِي مَحَلِّ رَفْعٍ مُبْتَدَأٌ."
            },
            {
                "sura_number": 112,
                "sura_name": "الإخلاص",
                "aya_number": 1,
                "word_number": 3,
                "word": "اللَّهُ",
                "content": "اسْمُ الْجَلَالَةِ مُبْتَدَأٌ ثَانٍ مَرْفُوعٌ وَعَلَامَةُ رَفْعِهِ الضَّمَّةُ الظَّاهِرَةُ."
            },
            {
                "sura_number": 112,
                "sura_name": "الإخلاص",
                "aya_number": 1,
                "word_number": 4,
                "word": "أَحَدٌ",
                "content": "خَبَرٌ لِاسْمِ الْجَلَالَةِ مَرْفُوعٌ وَعَلَامَةُ رَفْعِهِ الضَّمَّةُ الظَّاهِرَةُ، وَجُمْلَةُ ﴿اللَّهُ أَحَدٌ﴾ فِي مَحَلِّ رَفْعٍ خَبَرُ الْمُبْتَدَإِ ﴿هُوَ﴾."
            }
        ]
    },
    {
