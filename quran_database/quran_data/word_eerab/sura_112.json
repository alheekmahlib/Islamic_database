                "aya_number": 3,
                "word_number": 1,
                "word": "لَمْ",
                "content": "حَرْفُ نَفْيٍ وَجَزْمٍ مَبْنِيٌّ عَلَى السُّكُونِ."
            },
            {
                "sura_number": 112,
                "sura_name": "الإخلاص",
                "aya_number": 3,
                "word_number": 2,
                "word": "يَلِدْ",
                "content": "فِعْلٌ مُضَارِعٌ مَجْزُومٌ وَعَلَامَةُ جَزْمِهِ السُّكُونُ الظَّاهِرُ، وَالْفَاعِلُ ضَمِيرٌ مُسْتَتِرٌ تَقْدِيرُهُ (هُوَ)."
            },
            {
                "sura_number": 112,
                "sura_name": "الإخلاص",
                "aya_number": 3,
                "word_number": 3,
                "word": "وَلَمْ",
                "content": "(الْوَاوُ) حَرْفُ عَطْفٍ مَبْنِيٌّ عَلَى الْفَتْحِ، وَ﴿لَمْ﴾ حَرْفُ نَفْيٍ وَجَزْمٍ مَبْنِيٌّ عَلَى السُّكُونِ."
            },
            {
                "sura_number": 112,
                "sura_name": "الإخلاص",
                "aya_number": 3,
                "word_number": 4,
                "word": "يُولَدْ",
                "content": "فِعْلٌ مُضَارِعٌ مَبْنِيٌّ لِمَا لَمْ يُسَمَّ فَاعِلُهُ مَجْزُومٌ وَعَلَامَةُ جَزْمِهِ السُّكُونُ الظَّاهِرُ، وَنَائِبُ الْفَاعِلِ ضَمِيرٌ مُسْتَتِرٌ تَقْدِيرُهُ (هُوَ)."
            }
        ]
    },
    {
